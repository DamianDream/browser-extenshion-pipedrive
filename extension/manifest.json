{
  "manifest_version": 3,
  "name": "Pipedrive — видимость полей",
  "version": "1.1.1",
  "icons": {
    "16": "icons/transparent-16.png",
    "32": "icons/transparent-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "description": "Скрывайте группы и отдельные поля Pipedrive в удобной боковой панели.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://*.pipedrive.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Поля Pipedrive",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.pipedrive.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["*.mp3", "*.mp4", "icons/*"],
      "matches": ["https://*.pipedrive.com/*"]
    }
  ]
}
